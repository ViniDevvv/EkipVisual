<Window x:Class="EkipVisual.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EkipVisual.Models"
        xmlns:conv="clr-namespace:EkipVisual.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EkipVisual"
        Icon="Assets/logo.ico"
        Width="600" Height="800"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"/>

        <SolidColorBrush x:Key="Bg" Color="#0D0A16"/>
        <SolidColorBrush x:Key="Card" Color="#15111F"/>
        <SolidColorBrush x:Key="Border" Color="#241E33"/>
        <SolidColorBrush x:Key="Accent" Color="#06B6D4"/>
        <SolidColorBrush x:Key="Text" Color="#EDEBF5"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9A93B0"/>
        <SolidColorBrush x:Key="Green" Color="#34D399"/>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#241E33"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#1B1729"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#241E33"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1B1729"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <Style x:Key="NameBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1729"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                    BorderBrush="{StaticResource Border}" Background="Transparent" VerticalAlignment="Center">
                                <Path x:Name="check" Data="M 3,9 L 7,13 L 15,4" Stroke="{StaticResource Bg}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="#241E33"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barre de titre -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EkipVisual" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="Réglages visuels en jeu" FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="12,3,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Style="{StaticResource CloseBtn}" Click="Minimize_Click"/>
                    <Button Content="✕" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Presets -->
            <ItemsControl Grid.Row="1" Margin="0,20,0,0" ItemsSource="{Binding AllProfiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ColorProfile}">
                        <Grid Margin="0,0,8,8">
                            <Button Content="{Binding Name}" Style="{StaticResource PresetBtn}"
                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="✕" Style="{StaticResource IconBtn}" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                                    Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ajout d'un profil personnalisé -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Button Content="+ Enregistrer le réglage actuel comme profil" Style="{StaticResource GhostBtn}"
                        HorizontalAlignment="Left" Padding="10,6" FontSize="11"
                        Visibility="{Binding IsAddingProfile, Converter={StaticResource InverseBoolToVis}}"
                        Command="{Binding StartAddProfileCommand}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAddingProfile, Converter={StaticResource BoolToVis}}">
                    <TextBox Width="220" Style="{StaticResource NameBox}" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="Enregistrer" Style="{StaticResource AccentBtn}" Padding="12,7" FontSize="11" Margin="8,0,0,0"
                            Command="{Binding ConfirmAddProfileCommand}"/>
                    <Button Content="Annuler" Style="{StaticResource GhostBtn}" Padding="12,7" FontSize="11" Margin="6,0,0,0"
                            Command="{Binding CancelAddProfileCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Statut -->
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}"
                       FontSize="11" Margin="2,14,0,0"/>

            <!-- Curseurs -->
            <ScrollViewer Grid.Row="4" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <StackPanel Margin="0,0,0,22">
                    <Grid>
                        <TextBlock Text="Luminosité" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Brightness, StringFormat={}{0:0}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="-100" Maximum="100" Value="{Binding Brightness}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <Grid>
                        <TextBlock Text="Contraste" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Contrast, StringFormat={}{0:0}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="-100" Maximum="100" Value="{Binding Contrast}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <Grid>
                        <TextBlock Text="Gamma" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Gamma, StringFormat={}{0:0.00}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="0.4" Maximum="2.5" Value="{Binding Gamma}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22">
                    <Grid>
                        <TextBlock Text="Chaleur (froid ↔ chaud)" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Warmth, StringFormat={}{0:0}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="-100" Maximum="100" Value="{Binding Warmth}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,22" Visibility="{Binding HasRealVibrance, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text}">
                            <Run Text="Vibrance"/>
                            <Run Text="{Binding VibranceVendorName, StringFormat=({0}), Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontWeight="Normal" FontSize="11"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Vibrance, StringFormat={}{0:0}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="{Binding VibranceMin}" Maximum="{Binding VibranceMax}" Value="{Binding Vibrance}"
                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0"/>
                    <TextBlock Text="Vraie saturation matérielle (pas une approximation) — équivalent du curseur Digital Vibrance du panneau constructeur."
                               FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,4" Visibility="{Binding HasHue, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="Teinte" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Hue, StringFormat={}{0:0}°}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="{Binding HueMin}" Maximum="{Binding HueMax}" Value="{Binding Hue}"
                            IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,8,0,0"/>
                    <TextBlock Text="Rotation matérielle de la teinte globale — même mécanisme que la vibrance."
                               FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="AVANCÉ — BALANCE DES COULEURS (GAMMA PAR CANAL)" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextMuted}" Margin="0,24,0,14"/>

                <StackPanel Margin="0,0,0,18">
                    <Grid>
                        <TextBlock Text="Gamma Rouge" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GammaRed, StringFormat={}{0:0.00}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="0.5" Maximum="1.8" Value="{Binding GammaRed}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <Grid>
                        <TextBlock Text="Gamma Vert" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GammaGreen, StringFormat={}{0:0.00}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="0.5" Maximum="1.8" Value="{Binding GammaGreen}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,4">
                    <Grid>
                        <TextBlock Text="Gamma Bleu" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding GammaBlue, StringFormat={}{0:0.00}}" Foreground="{StaticResource Accent}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider Style="{StaticResource ColorSlider}" Minimum="0.5" Maximum="1.8" Value="{Binding GammaBlue}" Margin="0,8,0,0"/>
                </StackPanel>

            </StackPanel>
            </ScrollViewer>

            <!-- Options -->
            <StackPanel Grid.Row="5" Margin="0,16,0,0" Orientation="Horizontal">
                <CheckBox Content="Lancer avec Windows" Style="{StaticResource ToggleRow}" IsChecked="{Binding LaunchWithWindows}"/>
            </StackPanel>

            <!-- Raccourci + Discord -->
            <Grid Grid.Row="6" Margin="0,12,0,0">
                <TextBlock Text="discord.gg/YUKQRUj9Qs" FontSize="11" Foreground="{StaticResource Accent}"
                           Cursor="Hand" TextDecorations="Underline" MouseLeftButtonDown="Discord_Click"/>
                <TextBlock Text="Ctrl+Alt+E : activer/désactiver l'effet" FontSize="11"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Bas -->
            <Button Grid.Row="8" Content="Réinitialiser" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left"
                    Margin="0,10,0,0" Command="{Binding ResetCommand}"/>

        </Grid>
    </Border>
</Window>
